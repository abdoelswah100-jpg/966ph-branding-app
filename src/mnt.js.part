// ---------- maintenance (الصيانة): quarterly sheet, one line per job ----------
const MW=['تركيب','إزالة وتركيب','تغيير','صيانة (إعادة لصق)','إعادة تركيب','تصنيع وتركيب','طباعة فقط'];
const MWC={'تركيب':'DDF1E4','إزالة وتركيب':'DCEBFA','تغيير':'FFF4D1','صيانة (إعادة لصق)':'FDE7D9','إعادة تركيب':'E5E1F5','تصنيع وتركيب':'D6F0EF','طباعة فقط':'EFEFEF'};
const MMON=['','يناير','فبراير','مارس','أبريل','مايو','يونيو','يوليو','أغسطس','سبتمبر','أكتوبر','نوفمبر','ديسمبر'];
const mAds=()=>[...new Set(T.filter(t=>t.id!='ga').map(t=>t.n).concat(['End gandola - Header','End gandola - Side','Side Acrylic','أخرى']))];
function MU(){const c=DB.mnt=DB.mnt||{};c.items=c.items||[];c.cfg=Object.assign({region:(DB.cust&&DB.cust.cfg&&DB.cust.cfg.region)||'المنطقة الوسطى (الرياض)',sup:DB.cfg.dsup||'عبدالله السواح'},c.cfg||{});if(!c.cur)c.cur=mQ(TD());return c}
const mQ=dt=>{const y=String(dt).slice(0,4),m=+String(dt).slice(5,7)||1;return y+'-Q'+Math.ceil(m/3)};
const mQm=q=>{const n=+q.slice(-1);return [n*3-2,n*3-1,n*3]};
const mQLab=q=>{const n=+q.slice(-1),M=mQm(q);return `الربع ${['','الأول','الثاني','الثالث','الرابع'][n]} ${q.slice(0,4)} (${M.map(m=>MMON[m]).join(' + ')})`};
const mList=q=>MU().items.filter(x=>mQ(x.dt)==q).sort((a,b)=>(a.dt||'').localeCompare(b.dt||'')||(a.at||'').localeCompare(b.at||''));
const mStmt=x=>[x.work,x.det||(x.ad&&x.ad!='أخرى'?x.ad:''),x.sz?'مقاس '+x.sz:'',(+x.q||1)>1?'عدد '+x.q:''].filter(Boolean).join(' ');
function mPh(no){return DB.ph.filter(p=>String(p.no)==String(no)).sort((a,b)=>(b.mo||'').localeCompare(a.mo||''))[0]||null}
function mSize(ad,no){const p=mPh(no),s=p&&SH[p.sh]?p.sh:null;try{if(s==null)return '';if(ad=='Floor Header'){const v=SZ('fh.s')[s];return v?String(v):''}if(ad=='Medicated')return String(SZ('md.h')||'');if(ad=='Wall Header'){const v=SZ('wh.h')[s];return v?v+'×100':''}}catch(e){}return ''}
function mDraft(o){const last=mList(MU().cur).slice(-1)[0];return Object.assign({id:Date.now()+Math.floor(Math.random()*1000),dt:TD(),ph:'',ct:'',work:'تركيب',ad:'',det:'',sz:'',q:1,note:'',imb:[],ima:[]},o||{})}
function mOpen(d){V.me=d;goV(Object.assign(V,{v:'med'}))}
function mntHtml(){const C=MU(),q=C.cur,L=mList(q),qs=[...new Set(C.items.map(x=>mQ(x.dt)).concat([q,mQ(TD())]))].sort().reverse(),pcs=L.reduce((a,x)=>a+(+x.q||0),0),nph=new Set(L.map(x=>String(x.ph))).size;
 const grp=mQm(q).map(m=>{const R=L.filter(x=>+x.dt.slice(5,7)==m);return `<tr class="mmo"><td colspan="6">شهر ${MMON[m]} (${m}) — ${R.length} عمل · ${R.reduce((a,x)=>a+(+x.q||0),0)} قطعة</td></tr>`+(R.length?R.map(x=>`<tr data-med="${x.id}"><td class="cdt">${esc(x.dt.slice(8,10)+'-'+x.dt.slice(5,7))}</td><td><b>${esc(x.ph)}</b>${x.ct?`<small>${esc(x.ct)}</small>`:''}</td><td><small class="ck" style="background:#${MWC[x.work]||'EFEFEF'}">${esc(x.work)}</small></td><td>${esc(x.det||x.ad)}${x.det&&x.ad?`<small>${esc(x.ad)}</small>`:''}</td><td>${esc(x.sz||'')}</td><td><b>${esc(x.q)}</b>${(x.imb||[]).length+(x.ima||[]).length?'<small>📎</small>':''}</td></tr>`).join(''):'<tr><td colspan="6" class="em">لا توجد صيانات مسجلة</td></tr>')}).join('');
 return `<div class="wcard cust"><div class="cuh"><b>كشف صيانات ${esc(C.cfg.region)}</b><small>${mQLab(q)} · ${esc(C.cfg.sup)}</small></div>
 <div class="ckpi"><div><small>عدد الأعمال</small><b>${L.length}</b></div><div><small>عدد القطع</small><b>${pcs}</b></div><div><small>عدد الصيدليات</small><b>${nph}</b></div><div><small>الربع</small><b style="font-size:14px">${q.slice(-2)} · ${q.slice(0,4)}</b></div></div>
 <div class="cbtn"><button class="pr" data-madd="1">${ic('add')}إضافة صيانة</button>${L.length?`<button data-mrep="1">${ic('copy')}تكرار آخر بند</button>`:''}</div></div>
 <div class="wcard"><div class="cmo"><label>الربع<select id="mqsel">${qs.map(x=>`<option value="${x}"${x==q?' selected':''}>${mQLab(x)}</option>`).join('')}</select></label></div>
 <div class="sc"><table class="ctab mtab"><tr><th>التاريخ</th><th>الصيدلية</th><th>نوع العمل</th><th>التفاصيل</th><th>المقاس</th><th>العدد</th></tr>${grp}<tr class="tot"><td colspan="5">الإجمالي</td><td>${pcs}</td></tr></table></div><p class="sub">اضغط على أي بند علشان تعدّله أو تمسحه.</p>
 <div class="cshare"><button class="pr" data-mxl="share">${ic('sheet')}مشاركة Excel</button><button class="pr" data-mpdf="share">${ic('share')}مشاركة PDF</button><button data-mxl="save">${ic('download')}حفظ Excel</button><button data-mpdf="save">${ic('download')}حفظ PDF</button></div></div>
 <details class="pinfo" data-id="__mset"${V.op.__mset?' open':''}><summary>${ic('gear')} إعدادات الصيانة والاستيراد</summary><div class="fm"><label>المنطقة في عنوان الكشف<input data-mc="region" value="${esc(C.cfg.region)}"></label><label>اسم المشرف<input data-mc="sup" value="${esc(C.cfg.sup)}"></label><button data-pick="mjson">${ic('upload')}استيراد صيانات من ملف (اللي Claude بيجهّزه)</button><input type="file" id="mjson" accept=".json,application/json" hidden></div></details>`}
function medHtml(){const d=V.me;if(!d)return '';const nos=[...new Set(DB.ph.map(p=>String(p.no)))].sort((a,b)=>a-b),p=mPh(d.ph),ads=mAds(),pic=(k,L,lab)=>`<div><b>${lab}</b><div class="cimgs">${(L||[]).map(x=>`<span><button class="cimgb" data-cimgz="${x}"><img data-cimg="${x}" alt=""></button><button class="np cimgx" data-mimgx="${k}:${x}">✕</button></span>`).join('')}<button data-mpic="${k}">${ic('cam')}إضافة</button></div></div>`;
 return `<div class="wcard ced"><div class="fm">
 <div class="c2"><label>التاريخ<input type="date" data-mf="dt" value="${esc(d.dt)}"></label><label>رقم الصيدلية<input list="mphl" inputmode="numeric" data-mf="ph" value="${esc(d.ph)}"></label></div><datalist id="mphl">${nos.map(x=>`<option value="${x}">`).join('')}</datalist>
 ${p?`<div class="ph"><small>صيدلية ${esc(p.no)} · ${esc(RL(p)||'—')} · ${SH[p.sh]||'—'}</small></div>`:''}
 <label>المدينة<input data-mf="ct" value="${esc(d.ct)}"></label>
 <label>نوع العمل</label><div class="mwk">${MW.map(w=>`<button class="${w==d.work?'on':''}" data-mwork="${w}" style="--wc:#${MWC[w]}">${w}</button>`).join('')}</div>
 <div class="c2"><label>نوع الدعاية<select data-mf="ad"><option value="">—</option>${ads.map(a=>`<option${a==d.ad?' selected':''}>${esc(a)}</option>`).join('')}</select></label><label>المقاس (سم)<input data-mf="sz" value="${esc(d.sz)}" placeholder="مثلًا 30×140"></label></div>
 <label>التفاصيل<input data-mf="det" value="${esc(d.det)}" placeholder="مثلًا ستيكر على سايد أكريليك"></label>
 <div class="c2"><label>العدد<input type="number" inputmode="numeric" min="1" data-mf="q" value="${esc(d.q)}"></label><label>ملاحظات<input data-mf="note" value="${esc(d.note)}"></label></div>
 <div class="ph"><small>البيان للمحاسب: <b>${esc(mStmt(d))||'—'}</b></small></div>
 ${pic('b',d.imb,'صور قبل')}${pic('a',d.ima,'صور بعد')}<input type="file" id="mimg" accept="image/*" multiple hidden></div>
 <div class="tt"><button class="pr big" data-msave="1">${ic('check')}حفظ</button><button data-mcancel="1">إلغاء</button>${MU().items.some(x=>x.id==d.id)?`<button data-mdel="1" style="color:var(--rd)">${ic('trash')}مسح</button>`:''}</div></div>`}
function mSave(){const d=V.me;if(!/^\d{4}-\d{2}-\d{2}$/.test(d.dt||''))return alert('اختار التاريخ');if(!String(d.ph).trim())return alert('اكتب رقم الصيدلية');if(!d.ad&&!String(d.det).trim())return alert('اختار نوع الدعاية أو اكتب التفاصيل');const q=Math.round(+d.q||0);if(!(q>0))return alert('اكتب العدد');
 const x=Object.assign({},d,{q,ph:String(d.ph).trim(),det:String(d.det||'').trim(),at:d.at||nowIso()});const C=MU(),i=C.items.findIndex(y=>y.id==x.id);if(i>=0)C.items[i]=x;else C.items.push(x);C.cur=mQ(x.dt);sv();snd('ok');V.me=null;goV({v:'mnt',op:{},dr:{},q:V.q});toastT('✓ اتحفظت الصيانة')}
// ---- Excel (quarter, grouped by month) ----
function mntXlsx(q){const C=MU(),L=mList(q),M=mQm(q);const W=xlW();const NAVY='0B1B33',GOLD='F2B705',ZEB='F5F7FA',MUTE='5B6B80',CARD='EEF2F7';
 const H=['م','التاريخ','رقم الصيدلية','المدينة','نوع العمل','نوع الدعاية','التفاصيل','المقاس (سم)','العدد','البيان (للمحاسب)','ملاحظات'];
 W.put(1,0,`كشف صيانات ${C.cfg.region} — ${mQLab(q)}`,{sz:15,b:1,c:'FFFFFF',bg:NAVY,nb:1});W.merge('A1:K1');
 W.put(2,0,`المشرف: ${C.cfg.sup}  ·  966 Motors — صيدليات الدواء  ·  تاريخ الكشف: ${TD().split('-').reverse().join('-')}`,{c:MUTE,nb:1});W.merge('A2:K2');
 const pcs=L.reduce((a,x)=>a+(+x.q||0),0),nph=new Set(L.map(x=>String(x.ph))).size;
 [[0,2,'عدد الأعمال',L.length],[3,5,'عدد القطع',pcs],[6,6,'عدد الصيدليات',nph],[7,10,'الشهور',M.map(m=>MMON[m]).join(' + ')]].forEach(([a,b,l,v])=>{for(let i=a;i<=b;i++){W.put(4,i,i==a?l:'',{sz:9,b:1,c:MUTE,bg:CARD});W.put(5,i,i==a?v:'',{sz:14,b:1,c:NAVY,bg:CARD})}if(b>a){W.merge(`${colL(a)}4:${colL(b)}4`);W.merge(`${colL(a)}5:${colL(b)}5`)}});
 H.forEach((h,i)=>W.put(7,i,h,{b:1,c:'FFFFFF',bg:NAVY}));let r=8,k=0;const first=8;
 M.forEach(m=>{const R=L.filter(x=>+x.dt.slice(5,7)==m);for(let i=0;i<11;i++)W.put(r,i,i?'':`شهر ${MMON[m]} (${m}) — ${R.length} عمل · ${R.reduce((a,x)=>a+(+x.q||0),0)} قطعة`,{b:1,sz:11,c:NAVY,bg:'FFF6D6'});W.merge(`A${r}:K${r}`);W.ht(r,24);r++;
  if(!R.length){W.put(r,0,'لا توجد صيانات مسجلة',{c:MUTE});for(let i=1;i<11;i++)W.put(r,i,'',{});W.merge(`A${r}:K${r}`);r++;return}
  R.forEach(x=>{k++;const z=k%2?null:ZEB;[k,xlDate(x.dt),isNaN(+x.ph)?x.ph:+x.ph,x.ct||'',x.work,x.ad||'',x.det||'',x.sz||'',+x.q||0,mStmt(x),x.note||''].forEach((v,i)=>W.put(r,i,v,{bg:i==4?(MWC[x.work]||'EFEFEF'):z,b:i==2||i==8,sz:i==4?9:10,n:i==1?164:0}));W.ht(r,22);r++})});
 for(let i=0;i<11;i++)W.put(r,i,i==0?'الإجمالي':i==8?pcs:i==9?`${L.length} عمل في ${nph} صيدلية`:'',{b:1,sz:12,c:NAVY,bg:GOLD},i==8?`SUM(I${first}:I${r-1})`:null);W.merge(`A${r}:H${r}`);W.merge(`J${r}:K${r}`);W.ht(r,28);
 const s=r+2;[['A','D','توقيع المشرف: ....................'],['E','H','مراجعة: ....................'],['I','K','اعتماد المدير: ....................']].forEach(([a,b,t])=>{W.put(s,a.charCodeAt(0)-65,t,{c:MUTE,nb:1});W.merge(`${a}${s}:${b}${s}`)});
 [1,2,4,5,7].forEach(x=>W.ht(x,{1:34,2:20,4:18,5:26,7:30}[x]));
 const sh1=W.sheet({cols:[5,11,10,10,14,18,34,11,7,46,22],freeze:7,print:1});
 // summary
 const S=xlW(W.styles);S.put(1,0,`ملخص الصيانات — ${mQLab(q)}`,{sz:13,b:1,c:'FFFFFF',bg:NAVY});for(let i=1;i<3;i++)S.put(1,i,'',{bg:NAVY});S.merge('A1:C1');let rr=3;
 [['رقم الصيدلية','ph'],['نوع العمل','work'],['نوع الدعاية','ad']].forEach(([h,f])=>{[h,'عدد الأعمال','عدد القطع'].forEach((t,i)=>S.put(rr,i,t,{b:1,c:'FFFFFF',bg:NAVY}));rr++;
  [...new Set(L.map(x=>String(x[f]||'—')))].sort().forEach(v=>{const g=L.filter(x=>String(x[f]||'—')==v);S.put(rr,0,f=='ph'&&!isNaN(+v)?+v:v,{b:1,bg:f=='work'?MWC[v]:null});S.put(rr,1,g.length,{});S.put(rr,2,g.reduce((a,x)=>a+(+x.q||0),0),{});rr++});rr++});
 const sh2=S.sheet({cols:[22,14,12]});
 return xlBook([['الصيانة',sh1],['الملخص',sh2]],W,{print:'الصيانة',rows:'$7:$7'})}
// tiny xlsx writer shared by the maintenance sheet (styles registry + cells + merges)
function xlW(shared){const st=shared||{F:[],FI:{},P:['<fill><patternFill patternType="none"/></fill>','<fill><patternFill patternType="gray125"/></fill>'],PI:{},X:['<xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0"/>'],XI:{}};
 const w={styles:st,R:{},M:[],H:{},s(o){const S=w.styles,fk=(o.sz||10)+'|'+(o.b?1:0)+'|'+(o.c||'000000');if(S.FI[fk]==null){S.FI[fk]=S.F.length;S.F.push(`<font>${o.b?'<b/>':''}<sz val="${o.sz||10}"/><color rgb="FF${o.c||'000000'}"/><name val="Arial"/><family val="2"/></font>`)}let p=0;if(o.bg){if(S.PI[o.bg]==null){S.PI[o.bg]=S.P.length;S.P.push(`<fill><patternFill patternType="solid"><fgColor rgb="FF${o.bg}"/><bgColor indexed="64"/></patternFill></fill>`)}p=S.PI[o.bg]}
  const key=[S.FI[fk],p,o.n||0,o.nb?0:1].join('|');if(S.XI[key]==null){S.XI[key]=S.X.length;S.X.push(`<xf numFmtId="${o.n||0}" fontId="${S.FI[fk]}" fillId="${p}" borderId="${o.nb?0:1}" xfId="0" applyFont="1" applyFill="1" applyBorder="1" applyAlignment="1"${o.n?' applyNumberFormat="1"':''}><alignment horizontal="center" vertical="center" wrapText="1" readingOrder="2"/></xf>`)}return S.XI[key]},
  put(r,c,v,o,f){(w.R[r]=w.R[r]||[]).push({c,v,s:w.s(o||{}),f})},merge(m){w.M.push(m)},ht(r,h){w.H[r]=h},
  sheet(o){o=o||{};const rows=Object.keys(w.R).map(Number).sort((a,b)=>a-b).map(r=>`<row r="${r}"${w.H[r]?` ht="${w.H[r]}" customHeight="1"`:''}>${w.R[r].sort((a,b)=>a.c-b.c).map(x=>{const rf=colL(x.c)+r;return x.f?`<c r="${rf}" s="${x.s}"><f>${xe(x.f)}</f><v>${x.v}</v></c>`:typeof x.v=='number'?`<c r="${rf}" s="${x.s}"><v>${x.v}</v></c>`:x.v===''?`<c r="${rf}" s="${x.s}"/>`:`<c r="${rf}" s="${x.s}" t="inlineStr"><is><t xml:space="preserve">${xe(x.v)}</t></is></c>`}).join('')}</row>`).join('');
   return `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">${o.print?'<sheetPr><pageSetUpPr fitToPage="1"/></sheetPr>':''}<sheetViews><sheetView rightToLeft="1" workbookViewId="0">${o.freeze?`<pane ySplit="${o.freeze}" topLeftCell="A${o.freeze+1}" activePane="bottomLeft" state="frozen"/>`:''}</sheetView></sheetViews><cols>${(o.cols||[]).map((x,i)=>`<col min="${i+1}" max="${i+1}" width="${x}" customWidth="1"/>`).join('')}</cols><sheetData>${rows}</sheetData>${w.M.length?`<mergeCells count="${w.M.length}">${w.M.map(m=>`<mergeCell ref="${m}"/>`).join('')}</mergeCells>`:''}${o.print?'<printOptions horizontalCentered="1"/><pageMargins left="0.3" right="0.3" top="0.4" bottom="0.4" header="0.2" footer="0.2"/><pageSetup paperSize="9" orientation="landscape" fitToWidth="1" fitToHeight="0"/><headerFooter><oddFooter>&amp;Cصفحة &amp;P من &amp;N</oddFooter></headerFooter>':''}</worksheet>`}};
 if(!shared)w.s({});return w}
const xlDate=d=>{const[y,m,dd]=d.split('-').map(Number);return Math.round((Date.UTC(y,m-1,dd)-Date.UTC(1899,11,30))/864e5)};
function xlBook(sheets,W,pr){const S=W.styles,NS='http://schemas.openxmlformats.org';
 const styles=`<?xml version="1.0" encoding="UTF-8" standalone="yes"?><styleSheet xmlns="${NS}/spreadsheetml/2006/main"><numFmts count="1"><numFmt numFmtId="164" formatCode="dd\\-mm\\-yyyy"/></numFmts><fonts count="${S.F.length}">${S.F.join('')}</fonts><fills count="${S.P.length}">${S.P.join('')}</fills><borders count="2"><border><left/><right/><top/><bottom/><diagonal/></border><border>${['left','right','top','bottom'].map(s=>`<${s} style="thin"><color rgb="FFD5DCE6"/></${s}>`).join('')}<diagonal/></border></borders><cellStyleXfs count="1"><xf numFmtId="0" fontId="0" fillId="0" borderId="0"/></cellStyleXfs><cellXfs count="${S.X.length}">${S.X.join('')}</cellXfs><cellStyles count="1"><cellStyle name="Normal" xfId="0" builtinId="0"/></cellStyles></styleSheet>`;
 const f=[{n:'[Content_Types].xml',d:`<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Types xmlns="${NS}/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/><Override PartName="/xl/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml"/>${sheets.map((_,i)=>`<Override PartName="/xl/worksheets/sheet${i+1}.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>`).join('')}</Types>`},
  {n:'_rels/.rels',d:`<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="${NS}/package/2006/relationships"><Relationship Id="rId1" Type="${NS}/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/></Relationships>`},
  {n:'xl/workbook.xml',d:`<?xml version="1.0" encoding="UTF-8" standalone="yes"?><workbook xmlns="${NS}/spreadsheetml/2006/main" xmlns:r="${NS}/officeDocument/2006/relationships"><bookViews><workbookView/></bookViews><sheets>${sheets.map((s,i)=>`<sheet name="${xe(s[0])}" sheetId="${i+1}" r:id="rId${i+1}"/>`).join('')}</sheets>${pr?`<definedNames><definedName name="_xlnm.Print_Titles" localSheetId="0">'${xe(pr.print)}'!${pr.rows}</definedName></definedNames>`:''}<calcPr calcId="191029" fullCalcOnLoad="1"/></workbook>`},
  {n:'xl/_rels/workbook.xml.rels',d:`<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="${NS}/package/2006/relationships">${sheets.map((s,i)=>`<Relationship Id="rId${i+1}" Type="${NS}/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet${i+1}.xml"/>`).join('')}<Relationship Id="rId${sheets.length+1}" Type="${NS}/officeDocument/2006/relationships/styles" Target="styles.xml"/></Relationships>`},
  {n:'xl/styles.xml',d:styles}].concat(sheets.map((s,i)=>({n:`xl/worksheets/sheet${i+1}.xml`,d:s[1]})));
 return zipBlob(f,'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet')}
function mntPdfEl(q){const C=MU(),L=mList(q),pcs=L.reduce((a,x)=>a+(+x.q||0),0),nph=new Set(L.map(x=>String(x.ph))).size,el=document.createElement('div');let k=0;
 el.innerHTML=`<div class="cpt"><b>كشف صيانات ${esc(C.cfg.region)} — ${mQLab(q)}</b><small>المشرف: ${esc(C.cfg.sup)} · 966 Motors — صيدليات الدواء · تاريخ الكشف: ${TD().split('-').reverse().join('-')}</small></div>
 <div class="ckpi"><div><small>عدد الأعمال</small><b>${L.length}</b></div><div><small>عدد القطع</small><b>${pcs}</b></div><div><small>عدد الصيدليات</small><b>${nph}</b></div><div><small>الشهور</small><b style="font-size:12px">${mQm(q).map(m=>MMON[m]).join(' + ')}</b></div></div>
 <table class="cpdf"><tr><th>م</th><th>التاريخ</th><th>رقم الصيدلية</th><th>المدينة</th><th>نوع العمل</th><th>نوع الدعاية</th><th>التفاصيل</th><th>المقاس</th><th>العدد</th><th>ملاحظات</th></tr>
 ${mQm(q).map(m=>{const R=L.filter(x=>+x.dt.slice(5,7)==m);return `<tr class="copen"><td colspan="10">شهر ${MMON[m]} (${m}) — ${R.length} عمل · ${R.reduce((a,x)=>a+(+x.q||0),0)} قطعة</td></tr>`+(R.length?R.map(x=>`<tr><td>${++k}</td><td class="cdn">${x.dt.split('-').reverse().join('-')}</td><td><b>${esc(x.ph)}</b></td><td>${esc(x.ct||'')}</td><td style="background:#${MWC[x.work]||'EFEFEF'}"><b>${esc(x.work)}</b></td><td>${esc(x.ad||'')}</td><td>${esc(x.det||'')}</td><td>${esc(x.sz||'')}</td><td><b>${esc(x.q)}</b></td><td>${esc(x.note||'')}</td></tr>`).join(''):'<tr><td colspan="10">لا توجد صيانات مسجلة</td></tr>')}).join('')}
 <tr class="ctot"><td colspan="8">الإجمالي</td><td>${pcs}</td><td>${L.length} عمل في ${nph} صيدلية</td></tr></table>
 <div class="csig"><span>توقيع المشرف: ..............</span><span>مراجعة: ..............</span><span>اعتماد المدير: ..............</span></div>`;return el}
async function mExport(kind,mode){const q=MU().cur,nm=`صيانات ${MU().cfg.region.replace(/[\\/:*?"<>|]/g,'')} - ${q} - ${TD()}`;if(!mList(q).length&&!confirm('الربع ده مفيهوش صيانات. تكمل؟'))return;
 if(kind=='x'){let bl;try{bl=mntXlsx(q)}catch(e){console.error(e);return alert('تعذّر إنشاء ملف Excel')}const n=nm+'.xlsx';if(CAPN())return nativeSave(n,bl,bl.type,mode=='share');return mode=='share'?shr(n,bl,bl.type):out(n,bl,bl.type)}
 const el=mntPdfEl(q),ttl='كشف الصيانات — '+mQLab(q);if(mode=='share')return sharePdf({src:el,name:nm,title:ttl});const t=toast('جاري تجهيز ملف PDF…');try{const b=await buildPdf(el,ttl);t.remove();if(CAPN())return nativeSave(nm+'.pdf',b,'application/pdf',false);return out(nm+'.pdf',b,'application/pdf')}catch(e){t.remove();console.error(e);alert('تعذّر تجهيز ملف PDF')}}
async function mImport(f){let o;try{o=JSON.parse(await f.text())}catch(e){return alert('الملف ده مش ملف صيانات')}const L=Array.isArray(o)?o:o&&o.items;if(!L||!L.length)return alert('مفيش صيانات في الملف');const C=MU();let n=0,s=0;
 for(const y of L){const x=mDraft(Object.assign({},y));x.q=Math.round(+x.q||1);if(!/^\d{4}-\d{2}-\d{2}$/.test(x.dt||'')||!x.ph){s++;continue}if(C.items.some(z=>z.dt==x.dt&&String(z.ph)==String(x.ph)&&z.work==x.work&&z.ad==x.ad&&z.det==x.det&&String(z.sz)==String(x.sz)&&+z.q==+x.q)){s++;continue}x.ph=String(x.ph);x.at=nowIso();C.items.push(x);n++;C.cur=mQ(x.dt)}
 sv();render();alert(`✓ اتضاف ${n} بند${s?` · اتجاهل ${s} (مكرر أو ناقص)`:''}`)}
function mntClick(d){
 if(d.madd){mOpen(mDraft());return 1}
 if(d.mrep){const l=mList(MU().cur).slice(-1)[0];if(l)mOpen(mDraft({dt:l.dt,ph:l.ph,ct:l.ct,work:l.work,ad:l.ad,sz:l.sz,det:l.det,q:l.q}));return 1}
 if(d.med){const x=MU().items.find(y=>y.id==d.med);if(x)mOpen(JSON.parse(JSON.stringify(x)));return 1}
 if(d.mwork){V.me.work=d.mwork;render();return 1}
 if(d.msave){mSave();return 1}
 if(d.mcancel){V.me=null;goV({v:'mnt',op:{},dr:{},q:V.q});return 1}
 if(d.mdel){if(!confirm('تمسح البند ده؟'))return 1;const C=MU();C.items=C.items.filter(x=>x.id!=V.me.id);[...(V.me.imb||[]),...(V.me.ima||[])].forEach(k=>idbDel(k));sv();V.me=null;goV({v:'mnt',op:{},dr:{},q:V.q});toastT('✓ اتمسح');return 1}
 if(d.mpic){V.mpk=d.mpic;const i=$('#mimg');if(i)i.click();return 1}
 if(d.mimgx){const[k,x]=[d.mimgx.slice(0,1),d.mimgx.slice(2)];const f=k=='b'?'imb':'ima';V.me[f]=(V.me[f]||[]).filter(y=>y!=x);render();return 1}
 if(d.mxl){mExport('x',d.mxl);return 1}if(d.mpdf){mExport('p',d.mpdf);return 1}
 return 0}
function mntChange(x){
 if(x.id=='mimg'&&V.me){const L=[...x.files];x.value='';const f=V.mpk=='a'?'ima':'imb';(async()=>{for(const g of L){const k=await cImgPut(V.me.id,g);if(k)V.me[f]=(V.me[f]||[]).concat(k)}render()})();return 1}
 if(x.id=='mjson'){const f=x.files[0];x.value='';if(f)mImport(f);return 1}
 if(x.id=='mqsel'){MU().cur=x.value;svq();render();return 1}
 if(x.dataset.mc){MU().cfg[x.dataset.mc]=x.value;svq();return 1}
 if(x.dataset.mf&&V.me){mField(x);if(x.dataset.mf=='ph'||x.dataset.mf=='ad'){const q=k=>document.querySelector(`[data-mf=${k}]`);if(q('ct'))q('ct').value=V.me.ct||'';if(q('sz'))q('sz').value=V.me.sz||''}const b=document.querySelector('.ced .ph b');if(b)b.textContent=mStmt(V.me)||'—';return 1}
 return 0}
function mField(x){const d=V.me,k=x.dataset.mf;d[k]=x.value;if(k=='ph'){const p=mPh(x.value);if(p){if(!d.ct)d.ct=p.ct||'';if(d.ad&&!d.sz)d.sz=mSize(d.ad,x.value)}}if(k=='ad'){const z=mSize(d.ad,d.ph);if(z)d.sz=z}}
document.addEventListener('input',e=>{const x=e.target;if(x.dataset&&x.dataset.mf&&V.me&&V.v=='med'&&x.tagName=='INPUT'){V.me[x.dataset.mf]=x.value;const b=document.querySelector('.ced .ph b');if(b&&x.dataset.mf!='ph')b.textContent=mStmt(V.me)||'—'}});
